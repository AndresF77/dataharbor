# Copy to .env (git-ignored) and change the passwords before first start.
# Values below are local-only placeholders.

COMPOSE_PROJECT_NAME=dataharbor

# PostgreSQL: owner of the `dataharbor` (metadata) and `warehouse` databases
POSTGRES_USER=dataharbor
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# Airflow metadata database (created by the init script on first start)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-airflow

# Airflow web UI admin (local only)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-admin
AIRFLOW_PORT=8080
# Host user id that owns mounted DAG and log folders (run `id -u`)
AIRFLOW_UID=50000

# MinIO
MINIO_ROOT_USER=dataharbor
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_LANDING_BUCKET=dataharbor-landing-local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis
REDIS_PORT=6379
